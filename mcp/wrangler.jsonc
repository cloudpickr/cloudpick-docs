{
	"name": "cloudpick-docs-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"DOCS_BASE_URL": "https://docs.cloudpick.kr"
	},
	"routes": [
		{ "pattern": "docs.cloudpick.kr/mcp*", "zone_name": "cloudpick.kr" }
	],
	"durable_objects": {
		"bindings": [{ "name": "CloudPickDocsMCP", "class_name": "CloudPickDocsMCP" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["CloudPickDocsMCP"] }],
	"observability": { "enabled": true }
}
